<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis=1800000: Android ~30 min floor for periodic updates.
     Immediate refresh: DataStore writes (awaited) + MainActivity.onResume. No TIME_TICK.
     Width sized so all 7 month columns (incl. Sat/Sun) stay visible. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="340dp"
    android:minHeight="300dp"
    android:minResizeWidth="300dp"
    android:minResizeHeight="280dp"
    android:targetCellWidth="5"
    android:targetCellHeight="5"
    android:maxResizeHeight="480dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/gymcal_widget_loading"
    android:previewLayout="@layout/gymcal_widget_loading"
    android:widgetCategory="home_screen"
    android:description="@string/widget_month_description" />
